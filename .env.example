# postgresql
DB_HOST=db
DB_PORT=5432
DB_HOST_PORT=5433
DB_USER=vise
DB_PASSWORD=vise_secret
DB_NAME=inventario

# auth (JWT)
JWT_SECRET=reemplazar_por_un_string_largo_y_aleatorio
JWT_EXPIRES_IN=1h

# usuario semilla
SEED_USER_EMAIL=admin@vise.com
SEED_USER_PASSWORD=Admin123*

# inventario
LOW_STOCK_DEFAULT_THRESHOLD=10

# API
# PORT: puerto de la API al ejecutarla en local (npm run start:dev)
PORT=3000
# API_HOST_PORT: puerto expuesto en el host por Docker Compose
API_HOST_PORT=3000

# Frontend
# WEB_HOST_PORT: puerto de la interfaz web en el host (Docker Compose)
WEB_HOST_PORT=8080

# RPA (Parte 2)
# MOCK_HOST_PORT: puerto del servicio simulado de antecedentes en el host
MOCK_HOST_PORT=8000
# MOCK_FAILURE_RATE: probabilidad de un 503 aleatorio (0 a 1) para ejercitar los reintentos
MOCK_FAILURE_RATE=0.1
RPA_TIMEOUT_S=3
RPA_MAX_REINTENTOS=3
# RPA_ENMASCARAR_LOGS: oculta los dígitos centrales de cada cédula en el log (dato personal)
RPA_ENMASCARAR_LOGS=true
